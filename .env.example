# NewsAPI Configuration (Optional for Live Mode)
# Get a free key at https://newsapi.org
NEWSAPI_KEY=your_newsapi_key_here

# Mode setting: LIVE or REPLAY (Default: REPLAY)
INGESTION_MODE=REPLAY

# Replay speed delay between records in seconds
REPLAY_DELAY_SECONDS=1.0

# API Settings
HOST=0.0.0.0
PORT=8000
